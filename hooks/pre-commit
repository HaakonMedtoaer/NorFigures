#!/bin/sh
# Install: git config core.hooksPath hooks
# Runs the offline tests and scans staged changes for keys and stray hosts.
set -e
cd "$(git rev-parse --show-toplevel)"

python3 -m unittest -q || { echo "pre-commit: tests failed"; exit 1; }

# Only scan added lines in staged source and docs, not recordings.
added=$(git diff --cached -U0 -- . ':(exclude)tests/recorded' | grep '^+' | grep -v '^+++' || true)

if printf '%s\n' "$added" | grep -Eq 'sk-ant-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}'; then
  echo "pre-commit: something that looks like an API key is staged"; exit 1
fi

# Host scan covers runtime code only; tests name bad hosts on purpose.
# Data hosts (www.nav.no limited to two paths in net.py, D20) may appear anywhere in src/; the model host only in agents/llm.py (B19);
# loopback only in flowserver.py (B38).
scan() {
  git diff --cached -U0 -- "$@" | grep '^+' | grep -v '^+++' \
    | grep -Eo 'https?://[A-Za-z0-9.-]+' | sed -E 's#https?://##' | tr 'A-Z' 'a-z' | sort -u || true
}
for h in $(scan src ':(exclude)src/norfigures/agents/llm.py' ':(exclude)src/norfigures/flowserver.py' ':(exclude)src/norfigures/animation.py' ':(exclude)src/norfigures/sources/nav.py'); do
  case "$h" in
    data.ssb.no|data.norges-bank.no|www.nav.no) ;;
    *) echo "pre-commit: URL host '$h' in src/ is not on the allowlist"; exit 1 ;;
  esac
done
# The flow map's local server binds loopback only and fetches nothing (B38).
for h in $(scan src/norfigures/flowserver.py); do
  case "$h" in
    127.0.0.1) ;;
    *) echo "pre-commit: flowserver.py may only name 127.0.0.1, found '$h'"; exit 1 ;;
  esac
done
# The SVG namespace is an identifier, not a host; nothing is fetched from it.
for h in $(scan src/norfigures/animation.py); do
  case "$h" in
    www.w3.org) ;;
    *) echo "pre-commit: animation.py may only name the SVG namespace, found '$h'"; exit 1 ;;
  esac
done
# NAV's adapter names its host and the xlsx XML namespaces, which are identifiers,
# not hosts; nothing is fetched from them (D20).
for h in $(scan src/norfigures/sources/nav.py); do
  case "$h" in
    www.nav.no|schemas.openxmlformats.org) ;;
    *) echo "pre-commit: nav.py may only name www.nav.no and the xlsx namespaces, found '$h'"; exit 1 ;;
  esac
done
for h in $(scan src/norfigures/agents/llm.py); do
  case "$h" in
    api.anthropic.com) ;;
    *) echo "pre-commit: llm.py may only name api.anthropic.com, found '$h'"; exit 1 ;;
  esac
done
